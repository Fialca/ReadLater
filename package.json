  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
